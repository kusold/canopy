use flake

# Canopy local development environment.
# DATABASE_URL points at a local Postgres instance. The defaults below match
# the credentials used by Grove's testcontainers harness; override them by
# exporting different values before entering the shell, or by editing a
# git-ignored .envrc.local that direnv can source.
export DATABASE_URL=${DATABASE_URL:-postgres://grove:grove@localhost:5432/canopy?sslmode=disable}

# Run pending migrations automatically on startup so a fresh checkout comes up
# ready to serve. Production deployments typically override this with
# GROVE_MIGRATIONS=validate so schema changes go through a deliberate step.
export GROVE_MIGRATIONS=up
